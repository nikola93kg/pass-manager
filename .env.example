# ============================================================
# NMark Pass Vault v2 — Environment Configuration Template
# Copy to .env.local for local development. NEVER commit real secrets.
# ============================================================

# Canonical application URL (used for CSRF Origin validation & Client Hub deep links)
NEXT_PUBLIC_APP_URL=https://vault.nmarkdesigns.com

# ------------------------------------------------------------
# Supabase Encrypted Cloud Sync & Single-Admin Auth + MFA
# In production, cloud auth is REQUIRED (fail-closed) unless
# ALLOW_LOCAL_ONLY_MODE=true is explicitly set.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only single-admin allowlist (REQUIRED when Supabase is configured; fail-closed)
ALLOWED_ADMIN_EMAIL=
ALLOWED_ADMIN_USER_ID=

# Explicitly opt into local-only mode in production (default: false; always allowed in dev)
ALLOW_LOCAL_ONLY_MODE=false

# ------------------------------------------------------------
# Distributed Rate Limiting (Production-Safe Across Serverless Instances)
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only set to true for single-node VPS deployments without Redis
RATE_LIMIT_ALLOW_IN_MEMORY=false

# ------------------------------------------------------------
# Trusted Reverse Proxy Configuration for Client IP Extraction
# Allowed values: none | cloudflare | vercel | custom
# Default 'none' ignores client-spoofable X-Forwarded-For / X-Real-Ip headers.
# ------------------------------------------------------------
TRUSTED_PROXY_PROVIDER=none
# Only used when TRUSTED_PROXY_PROVIDER=custom (rightmost trusted proxy hop count)
TRUSTED_PROXY_HOP_COUNT=1

# ------------------------------------------------------------
# Optional: Live Staging Integration Tests (npm run test:staging)
# NEVER point these at production!
# ------------------------------------------------------------
STAGING_SUPABASE_URL=
STAGING_SUPABASE_ANON_KEY=
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=
STAGING_ADMIN_TOTP_CODE=
